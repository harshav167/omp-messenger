{
  "name": "omp-messenger",
  "version": "0.17.0",
  "description": "Inter-agent messaging, mesh channels, and crew orchestration for the oh-my-pi coding agent",
  "type": "module",
  "author": "Nico Bailon",
  "contributors": [
    "Harsha Vardhan"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harshav167/omp-messenger.git"
  },
  "homepage": "https://github.com/harshav167/omp-messenger#readme",
  "bugs": {
    "url": "https://github.com/harshav167/omp-messenger/issues"
  },
  "keywords": [
    "omp-plugin",
    "oh-my-pi",
    "extension",
    "messaging",
    "multi-agent",
    "coordination",
    "ai",
    "agents",
    "cli"
  ],
  "bin": {
    "omp-messenger-mesh": "mesh/server.ts"
  },
  "files": [
    "*.ts",
    "crew/**",
    "mesh/*.ts",
    "mesh/Dockerfile",
    "mesh/docker-compose.yml",
    "agents/**",
    "skills/**",
    "tern-plugin/plugin.toml",
    "tern-plugin/window.luau",
    "tern-plugin/*.css",
    "tern-plugin/dist/*.js",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "vitest run && bun test tests/bun",
    "test:node": "vitest run",
    "test:bun": "bun test tests/bun",
    "test:watch": "vitest",
    "build:mesh": "bun build --compile mesh/server.ts --outfile dist/omp-messenger-mesh",
    "build:tern": "bun build tern-plugin/app/main.ts --target=bun --outfile tern-plugin/dist/messenger.js",
    "prepack": "bun run build:tern"
  },
  "peerDependencies": {
    "@oh-my-pi/pi-ai": "^18.6.3",
    "@oh-my-pi/pi-agent-core": "^18.6.3",
    "@oh-my-pi/pi-coding-agent": "^18.6.3",
    "@oh-my-pi/pi-tui": "^18.6.3",
    "typebox": "*"
  },
  "dependencies": {
    "@stencil-hq/tern": "0.1.0"
  },
  "devDependencies": {
    "@oh-my-pi/pi-ai": "18.6.3",
    "@oh-my-pi/pi-agent-core": "18.6.3",
    "@oh-my-pi/pi-coding-agent": "18.6.3",
    "@oh-my-pi/pi-tui": "18.6.3",
    "@types/bun": "^1.4.0",
    "vitest": "^2.1.8"
  },
  "omp": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "./skills"
    ]
  }
}
